import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import firwin, freqz


Fs = 10000
Fc1 = 3000
Fc2 = 4900  # Valid upper cutoff below Nyquist
N = 31


# Design FIR Band-Pass Filter
