import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

# 1. Upload image
uploaded = files.upload()

# Read the uploaded image in grayscale
image_name = next(iter(uploaded))
img = cv2.imdecode(
    np.frombuffer(uploaded[image_name], np.uint8),
    cv2.IMREAD_GRAYSCALE
)

if img is None:
    raise ValueError("Could not read the image. Please upload a valid image.")

# 2. Fourier Transform
F = np.fft.fftshift(np.fft.fft2(img))
M, N = img.shape

# 3. Create frequency distance matrix
u, v = np.meshgrid(
    np.arange(N) - N // 2,
    np.arange(M) - M // 2
)
D = np.sqrt(u**2 + v**2)

# 4. Create Low-Pass and High-Pass Filters
LPF = D < 30
HPF = D >= 30

# 5. Apply filters
smooth = np.abs(np.fft.ifft2(np.fft.ifftshift(F * LPF)))
high_pass = np.abs(np.fft.ifft2(np.fft.ifftshift(F * HPF)))

# Sharpen image
sharp = np.clip(img.astype(float) + high_pass, 0, 255)

# 6. Display results
plt.figure(figsize=(12, 4))

plt.subplot(1, 3, 1)
plt.imshow(img, cmap='gray')
plt.title('Original Image')
plt.axis('off')

plt.subplot(1, 3, 2)
plt.imshow(smooth, cmap='gray')
plt.title('LPF - Smoothening')
plt.axis('off')

plt.subplot(1, 3, 3)
plt.imshow(sharp, cmap='gray')
plt.title('HPF - Sharpening')
plt.axis('off')

plt.tight_layout()
plt.show()






#B
import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

# 1. Upload image
uploaded = files.upload()

image_name = next(iter(uploaded))
img = cv2.imdecode(
    np.frombuffer(uploaded[image_name], np.uint8),
    cv2.IMREAD_GRAYSCALE
)

if img is None:
    raise ValueError("Please upload a valid image.")

# 2. Fourier Transform
F = np.fft.fftshift(np.fft.fft2(img))
M, N = img.shape

# 3. Create frequency distance matrix
u, v = np.meshgrid(
    np.arange(N) - N // 2,
    np.arange(M) - M // 2
)
D = np.sqrt(u**2 + v**2)

# 4. Create Low-Pass and High-Pass Filters
cutoff = 60

LPF = D < cutoff
HPF = D >= cutoff

# 5. Apply Low-Pass Filter (Smoothening)
smooth = np.abs(
    np.fft.ifft2(np.fft.ifftshift(F * LPF))
)

# 6. Apply High-Pass Filter
high_pass = np.real(
    np.fft.ifft2(np.fft.ifftshift(F * HPF))
)

# Normalize high-pass component for sharpening
high_pass = high_pass / (np.max(np.abs(high_pass)) + 1e-8) * 255

# 7. Sharpen the original image
strength = 0.5

sharp = np.clip(
    img.astype(float) + strength * high_pass,
    0, 255
).astype(np.uint8)

smooth = np.clip(smooth, 0, 255).astype(np.uint8)

# 8. Display results
plt.figure(figsize=(15, 5))

plt.subplot(1, 3, 1)
plt.imshow(img, cmap='gray', vmin=0, vmax=255)
plt.title('Original Image')
plt.axis('off')

plt.subplot(1, 3, 2)
plt.imshow(smooth, cmap='gray', vmin=0, vmax=255)
plt.title('LPF - Smoothening (Cutoff = 60)')
plt.axis('off')

plt.subplot(1, 3, 3)
plt.imshow(sharp, cmap='gray', vmin=0, vmax=255)
plt.title('HPF - Sharpening (Strength = 0.5)')
plt.axis('off')

plt.tight_layout()
plt.show()
