import cv2
import numpy as np
from google.colab import files
from google.colab.patches import cv2_imshow

# 1. Upload image
uploaded = files.upload()

# 2. Load the image in grayscale
image_name = next(iter(uploaded))
image = cv2.imdecode(
    np.frombuffer(uploaded[image_name], np.uint8),
    cv2.IMREAD_GRAYSCALE
)

if image is None:
    raise ValueError("Please upload a valid image.")

# 3. Convert image to binary
_, binary_image = cv2.threshold(
    image, 127, 255, cv2.THRESH_BINARY
)

# 4. Define the structuring element
# 1 = foreground, -1 = background, 0 = don't care
pattern = np.array([
    [-1,  1, -1],
    [ 1,  1,  1],
    [-1,  1, -1]
], dtype=np.int8)

# 5. Apply Hit-or-Miss Transformation
result = cv2.morphologyEx(
    binary_image,
    cv2.MORPH_HITMISS,
    pattern
)

# 6. Display the original, binary, and result images
print("Original Image")
cv2_imshow(image)

print("Binary Image")
cv2_imshow(binary_image)

print("Hit-or-Miss Transformation Result")
cv2_imshow(result)
